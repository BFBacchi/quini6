# ══════════════════════════════════════════════════════════
# Quini6 Analytics — Environment Variables
# Copy this file to .env and adjust as needed
# ══════════════════════════════════════════════════════════

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=quini6
POSTGRES_USER=quini6
POSTGRES_PASSWORD=quini6_dev_2026

# ─── Elasticsearch ──────────────────────────────────────
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200

# ─── RabbitMQ ───────────────────────────────────────────
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=quini6
RABBITMQ_PASSWORD=quini6_dev_2026

# ─── Backend (Spring Boot) ─────────────────────────────
SPRING_PROFILES_ACTIVE=docker
BACKEND_PORT=8080
JWT_SECRET=dev-only-change-in-prod-256bit-key-here
JWT_EXPIRATION_MS=86400000

# External APIs (kabeza/node_quini6)
QUINI6_API_PRIMARY=http://host.docker.internal:5000
QUINI6_API_SECONDARY=https://node-quini6.onrender.com

# Admin bootstrap credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ─── Frontend ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_WS_URL=ws://localhost:8080/ws

# ─── Debug profiles (optional) ──────────────────────────
# Activate with: docker compose --profile debug up
PGADMIN_ENABLED=true
KIBANA_ENABLED=false
