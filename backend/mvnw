#!/bin/sh
# Maven Wrapper script - downloads Maven if not present
set -e

MAVEN_VERSION="3.9.8"
MAVEN_HOME="${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"
MAVEN_URL="https://dlcdn.apache.org/maven/maven-3/${MAVEN_VERSION}/binaries/apache-maven-${MAVEN_VERSION}-bin.zip"

if [ ! -d "${MAVEN_HOME}" ]; then
    echo "Downloading Maven ${MAVEN_VERSION}..."
    mkdir -p "${MAVEN_HOME}"
    curl -fsSL "${MAVEN_URL}" | unzip -q - -d "${HOME}/.m2/wrapper/dists/"
    mv "${HOME}/.m2/wrapper/dists/apache-maven-${MAVEN_VERSION}"/* "${MAVEN_HOME}/" 2>/dev/null || true
fi

exec "${MAVEN_HOME}/bin/mvn" "$@"
